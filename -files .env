[1m--- /dev/null[m
[1m+++ b/app/main.py[m
[36m@@ -0,0 +1,101 @@[m
[32m+[m
[32m+[m[32mfrom fastapi import FastAPI, Depends[m
[32m+[m[32mfrom sqlalchemy.orm import Session[m
[32m+[m[32mfrom pydantic import BaseModel[m
[32m+[m
[32m+[m[32mfrom database import SessionLocal[m
[32m+[m[32mfrom model import Student[m
[32m+[m
[32m+[m[32mapp = FastAPI()[m
[32m+[m
[32m+[m[32mstudents = [][m
[32m+[m
[32m+[m
[32m+[m[32m# Database session[m
[32m+[m[32mdef get_db():[m
[32m+[m[32m    db = SessionLocal()[m
[32m+[m[32m    try:[m
[32m+[m[32m        yield db[m
[32m+[m[32m    finally:[m
[32m+[m[32m        db.close()[m
[32m+[m
[32m+[m
[32m+[m[32m# Student model for database input[m
[32m+[m[32mclass StudentCreate(BaseModel):[m
[32m+[m[32m    name: str[m
[32m+[m[32m    email: str[m
[32m+[m[32m    department: str[m
[32m+[m[32m    graduation_year: int[m
[32m+[m
[32m+[m
[32m+[m[32m# Add student to PostgreSQL[m
[32m+[m[32m@app.post("/db/students")[m
[32m+[m[32mdef create_student(student: StudentCreate, db: Session = Depends(get_db)):[m
[32m+[m
[32m+[m[32m    new_student = Student([m
[32m+[m[32m        name=student.name,[m
[32m+[m[32m        email=student.email,[m
[32m+[m[32m        department=student.department,[m
[32m+[m[32m        graduation_year=student.graduation_year[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    db.add(new_student)[m
[32m+[m[32m    db.commit()[m
[32m+[m[32m    db.refresh(new_student)[m
[32m+[m
[32m+[m[32m    return {[m
[32m+[m[32m        "message": "Student added successfully",[m
[32m+[m[32m        "student_id": new_student.id[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m
[32m+[m[32m# View students from PostgreSQL[m
[32m+[m[32m@app.get("/db/students")[m
[32m+[m[32mdef get_db_students(db: Session = Depends(get_db)):[m
[32m+[m[32m    return db.query(Student).all()[m
[32m+[m
[32m+[m
[32m+[m[32m# Home API[m
[32m+[m[32m@app.get("/")[m
[32m+[m[32mdef home():[m
[32m+[m[32m    return {"message": "Campus Placement System"}[m
[32m+[m
[32m+[m
[32m+[m[32m# Old CRUD using Python list[m
[32m+[m[32m@app.post("/students")[m
[32m+[m[32mdef add_student(name: str, age: int, course: str):[m
[32m+[m[32m    student = {[m
[32m+[m[32m        "name": name,[m
[32m+[m[32m        "age": age,[m
[32m+[m[32m        "course": course[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    students.append(student)[m
[32m+[m
[32m+[m[32m    return {"message": "Student added successfully"}[m
[32m+[m
[32m+[m
[32m+[m[32m@app.get("/students")[m
[32m+[m[32mdef get_students():[m
[32m+[m[32m    return students[m
[32m+[m
[32m+[m
[32m+[m[32m@app.put("/students/{student_id}")[m
[32m+[m[32mdef update_student(student_id: int, name: str):[m
[32m+[m[32m    if student_id < 0 or student_id >= len(students):[m
[32m+[m[32m        return {"message": "Student not found"}[m
[32m+[m
[32m+[m[32m    students[student_id]["name"] = name[m
[32m+[m
[32m+[m[32m    return {"message": "Student updated"}[m
[32m+[m
[32m+[m
[32m+[m[32m@app.delete("/students/{student_id}")[m
[32m+[m[32mdef delete_student(student_id: int):[m
[32m+[m[32m    if student_id < 0 or student_id >= len(students):[m
[32m+[m[32m        return {"message": "Student not found"}[m
[32m+[m
[32m+[m[32m    students.pop(student_id)[m
[32m+[m
[32m+[m[32m    return {"message": "Student deleted"}[m
[32m+[m
